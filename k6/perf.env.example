# Copy to qat/perf.env or pre/perf.env (git-ignored) and fill in. No secrets here — the token comes from run_perf.py's OTP login.

# API base INCLUDING /api
BASE_URL=https://<qat-api-host>/api

# Dedicated perf user (admin or manager with calls:read + departments:read)
PERF_EMAIL=perf-user@example.com
# true = take over any other active session of this user (the login screen's "continue anyway")
FORCE_LOGIN=true

# Where the 5000 calls go — the IDs must belong to the same hierarchy:
# client → department → program → group. run_perf.py checks this before uploading.
CLIENT_ID=
DEPARTMENT_ID=
PROGRAM_ID=
GROUP_ID=
# Optional: comma-separated agent UUIDs for round-robin assignment (empty = automatic)
AGENT_IDS=

ZIP_PATH=C:/perf/calls_5000.zip
EXPECTED_CALLS=5000

# Optional tuning (defaults in zip_upload_5000.js)
WAIT_FOR=evaluated
POLL_INTERVAL_S=30
BROWSE_VUS=5
BROWSE_DURATION=30m
