+"""UPLOAD_DATE_CYCLING controls the created_at of uploaded calls.
+
+true (default): back-dated by position in the zip, today - (index % 60) days, as before.
+false: every call is dated at upload time, so a load test's calls all land on one day.
+
+Runs the real helper from service.py without importing the app (no DB, broker or secrets needed).
+"""
+from __future__ import annotations
+
+import ast
+from datetime import datetime, timedelta, timezone
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+SERVICE = ROOT / "app" / "api" / "calls_upload_script" / "service.py"
+CONFIG = ROOT / "app" / "core" / "config.py"
+
+
+def _helper(cycling: bool):
+    """get_cycled_created_at compiled from service.py, with settings.UPLOAD_DATE_CYCLING stubbed."""
+    tree = ast.parse(SERVICE.read_text(encoding="utf-8"))
+    fn = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "get_cycled_created_at")
+    ns = {"datetime": datetime, "timezone": timezone, "timedelta": timedelta,
+          "settings": SimpleNamespace(UPLOAD_DATE_CYCLING=cycling)}
+    exec(compile(ast.Module(body=[fn], type_ignores=[]), str(SERVICE), "exec"), ns)  # noqa: S102 - our own source
+    return ns["get_cycled_created_at"]
+
+
+@pytest.mark.parametrize("index", [0, 1, 9, 59, 60, 4999])
+def test_cycling_off_dates_every_call_now(index):
+    before = datetime.now(timezone.utc)
+    got = _helper(cycling=False)(index)
+    assert before <= got <= datetime.now(timezone.utc)
+
+
+@pytest.mark.parametrize("index, days", [(0, 0), (1, 1), (9, 9), (59, 59), (60, 0), (61, 1)])
+def test_cycling_on_keeps_the_60_day_spread(index, days):
+    got = _helper(cycling=True)(index)
+    expected = datetime.now(timezone.utc) - timedelta(days=days)
+    assert abs(got - expected) < timedelta(seconds=5)
+
+
+def test_setting_defaults_to_cycling_on():
+    """Existing environments keep today's behaviour unless UPLOAD_DATE_CYCLING=false is set."""
+    src = CONFIG.read_text(encoding="utf-8")
+    assert 'os.getenv("UPLOAD_DATE_CYCLING", "true")' in src
